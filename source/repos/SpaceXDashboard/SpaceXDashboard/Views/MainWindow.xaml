<Window x:Class="SpaceXDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpaceX Dashboard"
        Height="700" Width="1100"
        Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <Button Content="Atualizar"
                        Command="{Binding RefreshCommand}"
                        DockPanel.Dock="Right"
                        Background="#1a73e8" Foreground="White"
                        BorderThickness="0"
                        Padding="14,6"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Cursor="Hand"/>

                <TabControl x:Name="MainTabs"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">

                    <TabItem Header="Estatísticas" FontSize="12"/>
                    <TabItem Header="Lançamentos" FontSize="12"/>
                    <TabItem Header="Foguetes"    FontSize="12"/>
                    <TabItem Header="Gráficos"    FontSize="12"/>

                </TabControl>
            </DockPanel>
        </Border>

        <!-- CONTEÚDO -->
        <Border Grid.Row="1" Background="#F9F9F9" Padding="16">
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="0">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel>

                                            <!-- CARDS -->
                                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="Total de lançamentos" FontSize="11" Foreground="#666"/>
                                                        <TextBlock Text="{Binding Stats.TotalLaunches}" FontSize="28" FontWeight="Medium" Foreground="#1C1C1C"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="Lançamentos com sucesso" FontSize="11" Foreground="#666"/>
                                                        <TextBlock Text="{Binding Stats.SuccessfulLaunches}" FontSize="28" FontWeight="Medium" Foreground="#1e7e34"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="Taxa de sucesso" FontSize="11" Foreground="#666"/>
                                                        <TextBlock Text="{Binding Stats.SuccessRate, StringFormat={}{0:F1}%}" FontSize="28" FontWeight="Medium" Foreground="#1a73e8"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <!-- BARRA POR FOGUETE -->
                                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16">
                                                <StackPanel>
                                                    <TextBlock Text="RESUMO POR FOGUETE" FontSize="11" Foreground="#666" FontWeight="Medium" Margin="0,0,0,12"/>
                                                    <ItemsControl ItemsSource="{Binding Rockets}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                                                                    <Border Grid.Column="1" Background="#EEEEEE" CornerRadius="2" Height="12" Margin="0,0,8,0">
                                                                        <Border Background="#1a73e8" CornerRadius="2" HorizontalAlignment="Left"
                                                                                Width="{Binding SuccessRatePct}"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding SuccessRatePct, StringFormat={}{0}%}" FontSize="11" Foreground="#555"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="1">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                                            <DataGrid ItemsSource="{Binding Launches}"
                                                      AutoGenerateColumns="False"
                                                      Background="White"
                                                      BorderThickness="0"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="#F0F0F0"
                                                      RowBackground="White"
                                                      AlternatingRowBackground="#FAFAFA"
                                                      FontSize="12"
                                                      ColumnHeaderHeight="32"
                                                      RowHeight="32">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nome"    Binding="{Binding Name}"    Width="*"/>
                                                    <DataGridTextColumn Header="Data"    Binding="{Binding DateUtc, StringFormat=dd/MM/yyyy}" Width="110"/>
                                                    <DataGridTextColumn Header="Foguete" Binding="{Binding RocketName}" Width="130"/>
                                                    <DataGridTextColumn Header="Status"  Binding="{Binding Success}" Width="90"/>
                                                    <DataGridTextColumn Header="Detalhes" Binding="{Binding Details}" Width="2*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="2">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
                                            <DataGrid ItemsSource="{Binding Rockets}"
                                                      AutoGenerateColumns="False"
                                                      Background="White"
                                                      BorderThickness="0"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="#F0F0F0"
                                                      RowBackground="White"
                                                      AlternatingRowBackground="#FAFAFA"
                                                      FontSize="12"
                                                      ColumnHeaderHeight="32"
                                                      RowHeight="32">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Nome"         Binding="{Binding Name}"          Width="*"/>
                                                    <DataGridTextColumn Header="Ativo"        Binding="{Binding Active}"        Width="80"/>
                                                    <DataGridTextColumn Header="Taxa sucesso" Binding="{Binding SuccessRatePct, StringFormat={}{0}%}" Width="110"/>
                                                    <DataGridTextColumn Header="Descrição"    Binding="{Binding Description}"   Width="3*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainTabs}" Value="3">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="LANÇAMENTOS POR ANO" FontSize="11" Foreground="#666" FontWeight="Medium" Margin="0,0,0,12"/>
                                                <ItemsControl ItemsSource="{Binding Launches}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding DateUtc, StringFormat=yyyy}" FontSize="11" Foreground="#555"/>
                                                                <Border Grid.Column="1" Background="#EEEEEE" CornerRadius="2" Height="12">
                                                                    <Border Background="#1a73e8" CornerRadius="2" HorizontalAlignment="Left" Width="100"/>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}"
                       FontSize="11" Foreground="#666"
                       VerticalAlignment="Center"
                       Margin="14,0"/>
        </Border>

    </Grid>
</Window>